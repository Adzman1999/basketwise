NODE_ENV=development
PORT=4000
# Create these databases locally and replace YOUR_LOCAL_DB_USER with your PostgreSQL role.
DATABASE_URL=postgresql://YOUR_LOCAL_DB_USER@localhost:5432/basketwise_dev
# API tests refuse databases that are remote or do not end in _test.
TEST_DATABASE_URL=postgresql://YOUR_LOCAL_DB_USER@localhost:5432/basketwise_test
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173
